    "test:exchange-registry": "tsx --test src/config/exchangeRegistry.test.ts",
    "test:financial": "tsx --test src/config/financialConfig.test.ts",
    "test:firebase": "node scripts/firebase-smoke.mjs",
    "test:integration": "node scripts/integration-test.mjs",
    "test:integration:staging": "BINANCE_TESTNET_INTEGRATION_TEST=true node scripts/integration-test.mjs",
    "test:network": "node scripts/network-preflight.mjs",
