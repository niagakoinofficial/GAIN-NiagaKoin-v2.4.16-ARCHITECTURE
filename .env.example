# ============================================================
# GAIN NiagaKoin v2.4.16 — local/staging environment template
# Copy with: npm run setup:local
# Never commit the resulting .env file.
# ============================================================

NODE_ENV=development
PORT=3000
GAIN_V2_ENABLED=true
VITE_APP_MODE=production

# -------------------- Local persistence --------------------
DATABASE_URL=postgresql://gain:gain@127.0.0.1:5432/gain
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=20
REDIS_URL=redis://127.0.0.1:6379
REDIS_REQUIRED=true

# -------------------- Firebase Web --------------------
VITE_FIREBASE_PROJECT_ID=gain-niagakoin-v4
VITE_FIREBASE_AUTH_DOMAIN="gain-niagakoin-v4.firebaseapp.com"
VITE_FIREBASE_API_KEY="AIzaSyBDKKM1hgKHwY98ctGkm-19katQ7GFgspU"
VITE_FIREBASE_STORAGE_BUCKET="gain-niagakoin-v4.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="840651864271"
VITE_FIREBASE_APP_ID="1:840651864271:web:69703e3938faf3d3be1fba"
VITE_FIREBASE_MEASUREMENT_ID="G-W41W7VXHT2"
VITE_FIREBASE_DATABASE_ID=(default)

# -------------------- Firebase Admin --------------------
# Prefer Application Default Credentials locally:
#   gcloud auth application-default login
# Or provide an absolute path to a service-account credential file.
FIREBASE_PROJECT_ID=your-firebase-project
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_ADMIN_ENABLED=false
FIREBASE_INTEGRATION_TEST=false
BSC_INTEGRATION_TEST=false
BINANCE_TESTNET_INTEGRATION_TEST=false

# -------------------- Server encryption --------------------
# Exactly 32 bytes for AES-256-GCM. setup:local generates one automatically.
ENCRYPTION_MASTER_KEY=

# -------------------- HTTP / CORS --------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DISABLE_HMR=false

# -------------------- Trading safety defaults --------------------
LIVE_TRADING_ENABLED=false
LIVE_TRADING_TESTNET_ONLY=true
BINANCE_TESTNET_PLACE_ORDERS=false
BINANCE_TESTNET_MAX_NOTIONAL_USDT=10
BINANCE_TESTNET_TIMEOUT_MS=15000
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=
BINANCE_TESTNET_ENDPOINTS=https://testnet.binance.vision

BOT_STARTUP_AUTO_RESUME=false
BOT_STARTUP_AUTO_RESUME_CONFIRM=
BOT_MAX_ORDER_USDT=50
BOT_MAX_EXPOSURE_USDT=250
BOT_USER_MAX_EXPOSURE_USDT=500
BOT_USER_MAX_DAILY_LOSS_USDT=25
BOT_USER_MAX_ORDERS_PER_MINUTE=5
BOT_MAX_COMMITTED_CAPITAL_USDT=250
BOT_MAX_DRAWDOWN_PCT=20
BOT_MAX_SPREAD_PCT=0.5
BOT_MAX_SLIPPAGE_PCT=0.35
BOT_MARKET_DATA_MAX_AGE_MS=10000

# -------------------- Exchange certification --------------------
EXCHANGE_CERT_MICRO_LIVE_ENABLED=false
EXCHANGE_CERT_MICRO_LIVE_CONFIRM=I_UNDERSTAND_MICRO_LIVE_CERTIFICATION
EXCHANGE_CERT_MAX_DEMO_NOTIONAL=10
EXCHANGE_CERT_MAX_LIVE_NOTIONAL=5
EXCHANGE_CERT_MAX_LIVE_NOTIONAL_IDR=50000
EXCHANGE_CERT_TIMEOUT_MS=10000

# -------------------- Transactional email (Resend) --------------------
# Required for registration/security-session email delivery.
RESEND_API_KEY=
RESEND_FROM=GAIN NiagaKoin <noreply@niagakoin.com>
# Legacy compatibility alias; RESEND_FROM is preferred.
SMTP_FROM=

# -------------------- BSC / financial processor --------------------
BSC_RPC_URL="https://bsc-mainnet.nodereal.io/v1/cad04d2cfdd8471d8a3995470ddbf98d"
BSC_RPC_URLS=
BSC_EXPECTED_CHAIN_ID=0x38
BSC_USDT_CONTRACT=0x55d398326f99059ff775485246999027b3197955
BSC_MIN_CONFIRMATIONS=12
GAIN_EXCHANGE_DEPOSIT_ADDRESS=
WITHDRAWAL_PROCESSOR_SECRET=

# -------------------- Operator/admin --------------------
GAIN_MASTER_OWNER_EMAIL=niagakoin.official@gmail.com
ADMIN_EMAILS=
NETWORK_PREFLIGHT_TIMEOUT_MS=8000
GAIN24_ENV_FILE=
